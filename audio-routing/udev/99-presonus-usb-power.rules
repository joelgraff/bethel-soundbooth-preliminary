# Disable USB autosuspend for the PreSonus StudioLive 32SX (idVendor=194f,
# idProduct=0809).
#
# Why: this Linux box has USB autosuspend enabled system-wide
# (/sys/module/usbcore/parameters/autosuspend = 2, i.e. suspend idle USB
# devices after 2s). The 32SX repeatedly drops/fails to enumerate on this
# machine (device descriptor read error -71, mid-session USB disconnects,
# "StudioLive Internal Clock Validity" stuck at Protocol error) — but the
# same board, same USB cable, has run on a MacBook for an extended period
# with zero failures (confirmed 2026-09-04). macOS does not autosuspend USB
# Audio Class interfaces the way Linux's default policy does, so this is
# the leading suspect for what's Linux-specific about the failure.
#
# See also: presonus-foh-bridge.service's RestartSec (bumped 2s -> 5s the
# same day) — its previous 2s retry loop meant that any time the device was
# already struggling, systemd was re-opening it every ~2-4s, which is a much
# more aggressive connection pattern than the Mac's single clean open. Both
# changes target the same symptom from different angles; keep both.
#
# Install (needs root — udev rules aren't user-writable):
#   sudo cp audio-routing/udev/99-presonus-usb-power.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=usb
# Then unplug/replug the 32SX (or power-cycle it) so the new power/control
# policy actually applies — udevadm trigger alone does not retroactively
# change power/control on an already-attached device in all cases.
#
# Verify once attached:
#   for d in /sys/bus/usb/devices/*/; do
#     grep -q 194f "$d/idVendor" 2>/dev/null && cat "$d/power/control"
#   done
#   # should print: on   (not "auto")

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="194f", ATTR{idProduct}=="0809", TEST=="power/control", ATTR{power/control}="on"
