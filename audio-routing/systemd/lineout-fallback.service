[Unit]
Description=FOH contingency: mirror the Mixer bus to the analog line-out (board ch 21)
Documentation=file:///home/soundbooth/soundbooth-project/audio-routing/tests/usb-reset-checklist.md
After=virtual-audio.service ensure-audio-routes.service
Wants=virtual-audio.service
PartOf=soundbooth.target
# Ceiling so this can't crash-loop forever — same convention as ffmpeg-capture.service.
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
ExecStart=%h/bin/start-lineout-fallback.sh
Restart=always
RestartSec=5

[Install]
WantedBy=soundbooth.target
