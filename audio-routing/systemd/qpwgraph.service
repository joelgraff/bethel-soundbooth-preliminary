[Unit]
Description=qpwgraph with saved patchbay
After=graphical-session.target virtual-sinks-loaded.target
Requires=graphical-session.target
# Ceiling so this can't crash-loop forever — same convention as ffmpeg-capture.service.
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
ExecStart=%h/bin/start-qpwgraph.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
