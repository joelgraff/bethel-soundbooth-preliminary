[Unit]
Description=FFmpeg SRT relay (local capture → Subsplash livestream)
Documentation=file:///home/soundbooth/soundbooth-project/SYSTEM-STATE.md
After=ffmpeg-capture.service graphical-session.target
Wants=ffmpeg-capture.service
PartOf=soundbooth.target
# Script waits for DNS of SRT host + ffmpeg-capture readiness
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
Environment=PATH=%h/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=180
# ffmpeg's own signal handler exits 255 on SIGTERM even for a clean stop
# (confirmed 2026-08-23) — without this, `systemctl stop` (stop-live-stream.sh)
# shows as "failed" instead of a clean stop, which would needlessly alarm an
# operator who just intentionally ended the stream.
SuccessExitStatus=255
ExecStart=%h/bin/start-ffmpeg-srt-relay.sh
# Auto-reconnect on unexpected death (network blip, Subsplash hiccup). A
# deliberate `systemctl --user stop` (stop-live-stream.sh) does NOT trigger
# this — that's the whole point: it's how the stream is ended on purpose.
Restart=always
RestartSec=8

# NO [Install] SECTION ON PURPOSE (changed 2026-09-13).
# This unit used to carry WantedBy=soundbooth.target, which meant `enable` put it
# in soundbooth.target.wants and **every boot started a livestream** — including
# midweek maintenance boots, because stop-live-stream.sh is a runtime `stop` and
# does not persist across a reboot. (In practice
# livestream-camera-watch.service then killed it ~75s later, so the machine was
# pushing ~75s of dead air to Subsplash on every boot.)
#
# The stream now starts exactly three ways, all deliberate:
#   1. ~/bin/start-live-stream.sh        manual
#   2. livestream-autostart.timer        recurring schedule (~/bin/livestream-schedule.sh)
#   3. dashboard livestream start        confirm-gated button
#
# Do not re-add [Install]/WantedBy here. To change when it auto-starts, set the
# timer's schedule; to disable scheduling entirely, disable the timer.
# PartOf=soundbooth.target above is kept deliberately: it propagates stop/restart
# from the target but never starts this unit.
