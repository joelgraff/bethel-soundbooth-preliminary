[Unit]
Description=Re-assert Mixer→Presonus and software→Mixer audio routes
Documentation=file:///home/soundbooth/soundbooth-project/SYSTEM-STATE.md
# After graph + sinks exist. (qpwgraph no longer started at boot, 2026-10-04.)
After=pipewire.service wireplumber.service virtual-sinks-loaded.target
Wants=virtual-sinks-loaded.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Brief settle so Presonus multichannel ports are up
ExecStartPre=/bin/sleep 3
ExecStart=/home/soundbooth/bin/ensure-audio-routes.sh

[Install]
WantedBy=soundbooth.target
