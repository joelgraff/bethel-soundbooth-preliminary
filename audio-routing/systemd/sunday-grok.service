[Unit]
Description=Soundbooth Sunday Grok troubleshooting session (interactive terminal)
Documentation=file:///home/soundbooth/soundbooth-project/SYSTEM-STATE.md
# After login; script waits for network + FFmpeg settle before opening terminal
After=graphical-session.target ffmpeg-capture.service
Wants=graphical-session.target

[Service]
Type=oneshot
# PATH must include ~/.grok/bin (user unit env often lacks it)
Environment=PATH=%h/bin:%h/.grok/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:0
# Script no-ops on non-Sunday and if already launched this boot
# Long timeout: net wait (default 180s) + settle delay
TimeoutStartSec=360
ExecStart=%h/bin/sunday-grok-session.sh
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
