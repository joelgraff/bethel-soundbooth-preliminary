[Unit]
Description=FFmpeg/ffplay program display on DP-4 (sanctuary TV)
Documentation=file:///home/soundbooth/soundbooth-project/SYSTEM-STATE.md
After=ffmpeg-capture.service graphical-session.target
Wants=ffmpeg-capture.service
# Do not BindsTo ffmpeg-capture — restarting encode would kill display and leave it failed

[Service]
Type=simple
Environment=PATH=%h/bin:%h/.grok/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:0
ExecStart=%h/bin/start-ffmpeg-display.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
