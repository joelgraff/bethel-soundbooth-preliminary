[Unit]
Description=Soundbooth Mixer → PreSonus FOH USB bridge
Documentation=file:///home/soundbooth/soundbooth-project/SYSTEM-STATE.md
After=pipewire.service pipewire-pulse.service wireplumber.service virtual-audio.service
Wants=pipewire.service pipewire-pulse.service virtual-audio.service
PartOf=soundbooth.target
# Ceiling so this can't crash-loop forever against an absent/flaky 32SX —
# same convention as ffmpeg-capture.service/ffmpeg-srt-relay.service. Without
# it, RestartSec=5 vs systemd's default 10s/5-try limiter never trips, so a
# board that's off for hours means hours of restart-every-5s log spam. After
# 30 tries in 10 minutes systemd marks it failed instead of retrying forever;
# `systemctl --user reset-failed presonus-foh-bridge.service` (or a restart)
# clears that once the board is back.
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
ExecStart=%h/bin/start-presonus-foh-bridge.sh
Restart=on-failure
# Was 2s. When the 32SX is having USB trouble, a 2s retry meant systemd was
# re-opening the device every ~2-4s (ExecStartPre sleep + fast-fail) —
# hammering an already-struggling device with fresh connection attempts
# instead of giving it room to settle. The same board/cable ran on a
# MacBook (single clean open, left alone) with zero failures over an
# extended period — see audio-routing/udev/99-presonus-usb-power.rules for
# the other half of this fix (USB autosuspend). 5s matches this project's
# convention for other flaky-hardware retry loops (e.g.
# camera-management.service).
RestartSec=5
# Give Mixer null sink time to appear after pulse
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=soundbooth.target
