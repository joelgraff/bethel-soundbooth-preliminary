[Unit]
Description=Auto-end Subsplash livestream when program camera loses power/network
Documentation=file:///home/soundbooth/soundbooth-project/SYSTEM-STATE.md
After=graphical-session.target
PartOf=soundbooth.target
# Ceiling so this can't crash-loop forever — same convention as ffmpeg-capture.service.
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
Environment=PATH=%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/bin/livestream-camera-watch.sh
Restart=always
RestartSec=5

[Install]
WantedBy=soundbooth.target
