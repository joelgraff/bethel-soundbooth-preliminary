[Unit]
Description=Watch FFmpeg SRT relay for mid-stream failure/hang; restart relay only
Documentation=file:///home/soundbooth/soundbooth-project/SYSTEM-STATE.md
After=ffmpeg-srt-relay.service
# Deliberately NOT Wants=ffmpeg-srt-relay.service (removed 2026-09-13). This unit
# is boot-enabled via soundbooth.target, so a Wants= here *pulled the livestream
# up at every boot* — silently defeating the point of disabling the relay's own
# boot autostart. After= alone gives the ordering without ever starting it.
# Safe because do_restart() in ffmpeg-srt-watch.sh already no-ops when the relay
# is inactive ("stream likely ended intentionally"), so this watcher is happy to
# idle from boot until the stream is actually started.
PartOf=soundbooth.target

[Service]
Type=simple
Environment=PATH=%h/bin:/usr/local/bin:/usr/bin:/bin
# Debounce / rate limit (override in drop-in or conf if needed)
# Environment=FFMPEG_SRT_WATCH_MIN_GAP_SEC=90
# Environment=FFMPEG_SRT_WATCH_MAX_PER_HOUR=8
ExecStart=%h/bin/ffmpeg-srt-watch.sh
Restart=always
RestartSec=5

[Install]
# WantedBy=graphical-session.target removed 2026-08-02: it added an implicit
# Before=graphical-session.target, which combined with this unit's own
# After=<the encode unit, then ffmpeg-srt.service, now ffmpeg-srt-relay.service>
# and that unit's own After=graphical-session.target formed a 3-way ordering
# cycle. systemd broke it by silently deleting the encode unit's start job
# every boot (never started). soundbooth.target (PartOf= above) already pulls
# this in. (2026-08-23: encode/SRT split into ffmpeg-capture.service +
# ffmpeg-srt-relay.service — this watcher now tracks the relay only.)
WantedBy=soundbooth.target
