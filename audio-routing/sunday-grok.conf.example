# Soundbooth Sunday auto-Grok (sourced by ~/bin/sunday-grok-session.sh)
#
# Set to 0 to disable without removing the systemd unit:
# SOUNDBOOTH_SUNDAY_GROK=0
#
# Max seconds to wait for default route + DNS (livestream needs this first):
SOUNDBOOTH_SUNDAY_GROK_NET_WAIT=180
#
# Extra seconds after network before opening the terminal (FFmpeg/displays settle):
SOUNDBOOTH_SUNDAY_GROK_DELAY=20
#
# Optional custom first prompt:
# SOUNDBOOTH_SUNDAY_GROK_PROMPT="/soundbooth Sunday boot — run health and report."

SOUNDBOOTH_SUNDAY_GROK=1
